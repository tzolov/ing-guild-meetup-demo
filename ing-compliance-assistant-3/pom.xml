<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.example</groupId>
		<artifactId>ing-guild-meetup-demo</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>ing-compliance-assistant-3</artifactId>
	<name>ING 1 - Compliance Assistant (modular, simple)</name>
	<description>ING meetup demo 1, modular version without per-source retrieval: fixed query angles, one VectorStoreDocumentRetriever, Jev screening and reranking, Gemini structured output</description>

	<dependencies>
		<dependency>
			<groupId>com.example</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<!-- Gemini chat and embeddings, the only model family ING's GenAI platform runs -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-google-genai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-google-genai-embedding</artifactId>
		</dependency>
		<!-- Modular RAG: RetrievalAugmentationAdvisor and its pluggable stages -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-rag</artifactId>
		</dependency>
		<!-- Post-retrieval screening and reranking with TypeSafe's Jev model (see application.properties) -->
		<dependency>
			<groupId>org.springaicommunity</groupId>
			<artifactId>spring-ai-starter-typesafe</artifactId>
			<version>${spring-ai-typesafe.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springaicommunity</groupId>
			<artifactId>typesafe-spring-ai</artifactId>
			<version>${spring-ai-typesafe.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
