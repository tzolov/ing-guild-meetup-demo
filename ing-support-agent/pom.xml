<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.example</groupId>
		<artifactId>ing-guild-meetup-demo</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>ing-support-agent</artifactId>
	<name>ING 2 - First-Time-Right Support Agent</name>
	<description>ING meetup demo 2: intent classification, tools on existing service beans, session memory, PII masking, handoff</description>

	<dependencyManagement>
		<dependencies>
			<!-- The Google GenAI SDK pulls protobuf-java 3.25 (compile scope, so it wins by proximity) while the
			     OpenTelemetry starter's opentelemetry-proto is generated for protobuf 4 (RuntimeVersion$RuntimeDomain).
			     The 4.x runtime still loads the SDK's 3.x-generated classes, so the newer one is pinned. -->
			<dependency>
				<groupId>com.google.protobuf</groupId>
				<artifactId>protobuf-java</artifactId>
				<version>4.32.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>com.example</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<!-- Gemini, the only model family ING's GenAI platform runs -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-google-genai</artifactId>
		</dependency>
		<!-- Conversation memory across turns -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-session-advisor</artifactId>
		</dependency>
		<!-- In-memory SQL database standing in for the bank's account and mortgage systems -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- The audit trail, Grafana stack in docker/, active with the 'otel' profile:
		     metrics scraped from /actuator/prometheus, traces over OTLP to Tempo, logs to Loki, all in Grafana -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.loki4j</groupId>
			<artifactId>loki-logback-appender</artifactId>
			<version>2.0.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
